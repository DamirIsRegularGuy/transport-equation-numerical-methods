Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"v", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", 
       RowBox[{"IntegerPart", "[", "t", "]"}]}], "\n", 
      RowBox[{"a", "[", "t_", "]"}]}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FractionalPart", "[", "t", "]"}], ",", 
          RowBox[{"EvenQ", "[", 
           RowBox[{"IntegerPart", "[", "t", "]"}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "-", 
           RowBox[{"FractionalPart", "[", "t", "]"}]}], ",", 
          RowBox[{"OddQ", "[", 
           RowBox[{"IntegerPart", "[", "t", "]"}], "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "}"}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", 
     RowBox[{"IntegerPart", "[", "t", "]"}]}]}], "\n", 
   RowBox[{
    RowBox[{"fsol", "=", 
     RowBox[{
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"s", "'"}], "[", "t", "]"}], "==", 
           RowBox[{"a", "[", "t", "]"}]}], ",", 
          RowBox[{
           RowBox[{"s", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "s", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "4"}], "}"}]}], " ", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"phi0", "[", "z_", "]"}], ":=", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       RowBox[{"z", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"phi0", "[", "z_", "]"}], ":=", 
     RowBox[{"UnitStep", "[", "z", "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", 
       RowBox[{"t_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"phi0", "[", 
      RowBox[{"x", "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s", "[", "t", "]"}], "/.", "fsol"}], ")"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
     RowBox[{"PlotPoints", "->", "50"}]}], "]"}], "\n", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.976018772126087*^9, 3.9760187729083443`*^9}, {
