  RowBox[{
   RowBox[{
    RowBox[{"schemeColors", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Upwind\>\"", "->", "Red"}], ",", 
       RowBox[{"\"\<LF\>\"", "->", "Blue"}], ",", 
       RowBox[{"\"\<LW\>\"", "->", "Orange"}], ",", 
       RowBox[{"\"\<Visc\>\"", "->", "Purple"}], ",", 
