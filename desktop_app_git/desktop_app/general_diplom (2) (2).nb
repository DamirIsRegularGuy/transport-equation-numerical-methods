Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"plotAtTime", "[", "n_", "]"}], ":=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"showUpwind", ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"xgrid", ",", 
              RowBox[{"uJavnmeth", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], "}"}], "]"}], ",", 
           "Nothing"}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{"showLF", ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"xgrid", ",", 
              RowBox[{"uJavnLaxFrid", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], "}"}], "]"}], ",", 
           "Nothing"}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{"showLW", ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"xgrid", ",", 
              RowBox[{"uJavnLaxVander", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], "}"}], "]"}], ",", 
           "Nothing"}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"showLax", ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"xgrid", ",", 
