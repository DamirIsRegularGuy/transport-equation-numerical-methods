Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "x_", "]"}], ":=", 
   RowBox[{"1", "+", 
    RowBox[{"0.5", "*", 
     RowBox[{"Sin", "[", "x", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fsol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"f", "'"}], "[", "x", "]"}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"a", "[", "x", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"f", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", "f", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "5"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phi0", "[", "z_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{"z", "^", "2"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"phi0", "[", "z_", "]"}], ":=", 
    RowBox[{"UnitStep", "[", "z", "]"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{
     RowBox[{"x_", "?", "NumericQ"}], ",", 
     RowBox[{"t_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"phi0", "[", 
    RowBox[{"t", "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", "x", "]"}], "/.", " ", "fsol"}], ")"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "6"}], "}"}], ",", 
   RowBox[{"PlotPoints", "->", "50"}]}], "]"}], "\n", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "6"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.974983642488388*^9, 3.97601972799333*^9, {3.97601981364118*^9, 
   3.97601987487014*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"a7bb9216-4cfb-704d-b692-8dabe1a4c2a3"],

