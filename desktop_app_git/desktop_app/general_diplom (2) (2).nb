 RowBox[{
  RowBox[{"u", "[", 
   RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
  RowBox[{
   TemplateBox[{"1"},
    "C"], "[", 
   RowBox[{"t", "-", 
    FractionBox["x", "a"]}], "]"}]}]], "Output",
