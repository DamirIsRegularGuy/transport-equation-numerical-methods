Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u1", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", " ", "t"}], "]"}], "+", 
       RowBox[{
        RowBox[{"a", "[", "x", "]"}], "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u1", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", "0"}],
      "}"}], ",", " ", 
    RowBox[{"u1", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", " ", 
    RowBox[{"{", 
