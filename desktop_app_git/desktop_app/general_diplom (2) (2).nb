Cell[BoxData[
 RowBox[{
  RowBox[{"u1", "[", 
   RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
  RowBox[{
   TemplateBox[{"1"},
    "C"], "[", 
   RowBox[{"t", "-", 
    TemplateBox[{
      FractionBox["1", 
       RowBox[{"a", "[", 
         RowBox[{"K", "[", "1", "]"}], "]"}]], 
      RowBox[{"K", "[", "1", "]"}], "1", "x"},
     "InactiveIntegrate",
     DisplayFunction->(RowBox[{
        SubsuperscriptBox[
         StyleBox["\[Integral]", "Inactive"], #3, #4], 
        RowBox[{#, 
          RowBox[{
            StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
     InterpretationFunction->(RowBox[{
        RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
        RowBox[{#, ",", 
          RowBox[{"{", 
            RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}], 
   "]"}]}]], "Output",
 CellChangeTimes->{3.974983817210249*^9, 3.9749839198280296`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"9a8dab82-a8ac-bb41-956c-5149262b11bf"]
}, Open  ]],

