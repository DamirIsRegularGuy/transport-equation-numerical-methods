Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u4", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", " ", "t"}], "]"}], "+", 
