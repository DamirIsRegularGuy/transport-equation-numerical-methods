Cell[BoxData[
 RowBox[{
  RowBox[{"u4", "[", 
   RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
  RowBox[{
   TemplateBox[{"1"},
    "C"], "[", 
   RowBox[{
    RowBox[{"-", "x"}], "+", 
    TemplateBox[{
      RowBox[{"a", "[", 
        RowBox[{"K", "[", "1", "]"}], "]"}], 
      RowBox[{"K", "[", "1", "]"}], "1", "t"},
     "InactiveIntegrate",
     DisplayFunction->(RowBox[{
        SubsuperscriptBox[
         StyleBox["\[Integral]", "Inactive"], #3, #4], 
        RowBox[{#, 
          RowBox[{
            StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
     InterpretationFunction->(RowBox[{
        RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
        RowBox[{#, ",", 
          RowBox[{"{", 
            RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}], 
   "]"}]}]], "Output",
