Cell[BoxData[
 RowBox[{
  RowBox[{"u3", "[", 
   RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
  RowBox[{
   TemplateBox[{"1"},
    "C"], "[", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", "t"}]], " ", 
    RowBox[{"(", 
