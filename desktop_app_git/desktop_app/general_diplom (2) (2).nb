Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{"Clear", "[", "u", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", " ", "t"}], "]"}], "+", 
       RowBox[{"a", "*", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", "0"}],
      "}"}], ",", " ", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}], "[", 
  RowBox[{"[", 
