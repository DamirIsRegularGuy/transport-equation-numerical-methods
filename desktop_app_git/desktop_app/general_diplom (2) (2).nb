 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"plotAt", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "lines", "}"}], ",", 
      RowBox[{
       RowBox[{"lines", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", "dataCol", "}"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"data", "=", 
                 RowBox[{"dataCol", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                RowBox[{"col", "=", 
                 RowBox[{"dataCol", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", "yvals"}], "}"}], ",", 
              RowBox[{
               RowBox[{"yvals", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Head", "[", "data", "]"}], "===", "Function"}], ",", 
                  RowBox[{"data", "[", "n", "]"}], ",", 
                  RowBox[{"data", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"xgrid", ",", "yvals"}], "}"}], "]"}]}]}], "]"}]}], 
