       RowBox[{"{", 
        RowBox[{"time", ",", "times"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotNormDynamic", "[", 
     RowBox[{"normIndex_", ",", "normName_"}], "]"}], ":=", 
